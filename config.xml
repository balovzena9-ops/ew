<?xml version='1.0' encoding='utf-8'?>
<widget 
    id="com.myrunplay.mayumsyka" 
    version="1.1.0" 
    android-versionCode="5"
    xmlns="http://www.w3.org/ns/widgets" 
    xmlns:cdv="http://cordova.apache.org/ns/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <name>MayUmshka</name>
    <description>MayUmshka - Chapter 1</description>
    <author email="support@myrunplay.com" href="https://myrunplay.com">
        MayRunPlay
    </author>

    <content src="index.html" />

    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />

    <platform name="android">

        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="34" />
        <preference name="android-compileSdkVersion" value="34" />

        <icon density="ldpi"    src="www/icon.png" />
        <icon density="mdpi"    src="www/icon.png" />
        <icon density="hdpi"    src="www/icon.png" />
        <icon density="xhdpi"   src="www/icon.png" />
        <icon density="xxhdpi"  src="www/icon.png" />
        <icon density="xxxhdpi" src="www/icon.png" />

        <splash density="land-ldpi"    src="www/icon.png" />
        <splash density="land-mdpi"    src="www/icon.png" />
        <splash density="land-hdpi"    src="www/icon.png" />
        <splash density="land-xhdpi"   src="www/icon.png" />
        <splash density="land-xxhdpi"  src="www/icon.png" />
        <splash density="land-xxxhdpi" src="www/icon.png" />
        <splash density="port-ldpi"    src="www/icon.png" />
        <splash density="port-mdpi"    src="www/icon.png" />
        <splash density="port-hdpi"    src="www/icon.png" />
        <splash density="port-xhdpi"   src="www/icon.png" />
        <splash density="port-xxhdpi"  src="www/icon.png" />
        <splash density="port-xxxhdpi" src="www/icon.png" />

        <preference name="AndroidInsecureFileModeEnabled" value="true" />
        <preference name="AndroidLaunchMode" value="singleTop" />
        <preference name="Orientation" value="portrait" />
        <preference name="Fullscreen" value="true" />
        <preference name="SplashMaintainAspectRatio" value="true" />
        <preference name="SplashShowOnlyFirstTime" value="false" />
        <preference name="SplashScreenDelay" value="2000" />

    </platform>

    <!-- Цвета ТОЛЬКО в формате #RRGGBB / #AARRGGBB -->
    <preference name="DisallowOverscroll" value="true" />
    <preference name="BackgroundColor" value="#ff000000" />
    <preference name="StatusBarOverlaysWebView" value="true" />
    <preference name="StatusBarBackgroundColor" value="#ff000000" />
    <preference name="StatusBarStyle" value="lightcontent" />

</widget>
